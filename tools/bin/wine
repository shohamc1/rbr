#!/bin/sh
# reccmp runs cvdump.exe through `wine`. Run it in the pinned MSVC Wine image,
# with the repository mounted read-only at its host path.
root=$(cd "$(dirname "$0")/../.." && pwd -P)
exec docker run --rm -i --platform linux/386 --network none \
    --mount "type=bind,src=$root,dst=$root,readonly" \
    "$(cat "$root/tools/local/msvc-wine-image.txt")" "$@" 2>/dev/null
